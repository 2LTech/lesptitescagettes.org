{
  "name": "lesptitescagettes.org",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "depcheck": "depcheck --ignores='@types/*,eslint,eslint-config-next'",
    "prettier": "prettier -l '**/*.{js,jsx,ts,tsx,json,md,css}'",
    "lint": "next lint",
    "doc": "typedoc  --options .config/typedoc.js",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "sitemap": "next-sitemap --config sitemap.config.mjs"
  },
  "dependencies": {
    "next": "15.5.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@react-google-maps/api": "2.20.7",
    "@types/bezier-js": "4.1.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "bezier-js": "6.1.4",
    "depcheck": "1.4.7",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.0",
    "next-sitemap": "4.2.3",
    "prettier": "3.6.2",
    "typedoc": "0.28.11",
    "typescript": "5.9.2"
  },
  "packageManager": "yarn@4.9.3"
}
