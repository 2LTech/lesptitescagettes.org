{
  "name": "lesptitescagettes.org",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "scripts": {
    "depcheck": "depcheck --ignores='@types/*,eslint-config-next'",
    "prettier": "prettier -l '**/*.{js,jsx,ts,tsx,json,md,css}'",
    "lint": "eslint .",
    "doc": "typedoc  --options .config/typedoc.js",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "sitemap": "next-sitemap --config sitemap.config.mjs"
  },
  "dependencies": {
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@react-google-maps/api": "2.20.8",
    "@types/bezier-js": "4.1.3",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bezier-js": "6.1.4",
    "depcheck": "1.4.7",
    "eslint": "10.1.0",
    "eslint-config-next": "16.2.1",
    "next-sitemap": "4.2.3",
    "prettier": "3.8.1",
    "typedoc": "0.28.18",
    "typescript": "6.0.2"
  },
  "packageManager": "yarn@4.9.3"
}
